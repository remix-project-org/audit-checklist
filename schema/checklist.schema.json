{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/remix-project-org/audit-checklist/schema/checklist.schema.json",
  "title": "Audit checklist",
  "description": "checklist.json: a tree of category nodes whose leaves are checklist items. Item fields up to `tags` are the upstream Cyfrin format and keep their meaning; the remaining fields are additive tags. Vocabulary membership (vuln_category, feature keys, compiler settings, slither IDs) and semver syntax are enforced by scripts/validate.py against schema/vocabulary.json. See SCHEMA.md.",
  "type": "array",
  "items": {"$ref": "#/$defs/categoryNode"},
  "$defs": {
    "categoryNode": {
      "type": "object",
      "required": ["category", "description", "data"],
      "additionalProperties": false,
      "properties": {
        "category": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "data": {
          "type": "array",
          "minItems": 1,
          "items": {
            "if": {"type": "object", "required": ["data"]},
            "then": {"$ref": "#/$defs/categoryNode"},
            "else": {"$ref": "#/$defs/item"}
          }
        }
      }
    },
    "item": {
      "type": "object",
      "required": ["id", "question", "description", "remediation", "references", "tags", "vuln_category", "severity_prior", "applicability", "verification", "provenance", "review_status"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^SOL-[A-Za-z0-9]+(-[A-Za-z0-9]+)*-[0-9]+$", "description": "Stable upstream-style ID: SOL-<category path abbreviation>-<n>."},
        "question": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "remediation": {"type": "string"},
        "references": {"type": "array", "items": {"type": "string"}},
        "tags": {"type": "array", "items": {"type": "string"}},
        "vuln_category": {"type": "string", "description": "Key of vocabulary.json#/vuln_categories."},
        "severity_prior": {"enum": ["critical", "high", "medium", "low", "informational"]},
        "applicability": {"$ref": "#/$defs/applicability"},
        "detection_hint": {"$ref": "#/$defs/detectionHint"},
        "verification": {"$ref": "#/$defs/verification"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "review_status": {"enum": ["human_reviewed", "auto_tagged", "needs_review"]},
        "review_notes": {"type": "string", "minLength": 1, "description": "Why the item needs review, or what a reviewer decided."}
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "description": "All present clauses must hold. An empty object means the item always applies.",
      "properties": {
        "all_of": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "any_of": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "solc": {"type": "string", "minLength": 1, "description": "node-semver style range of affected compiler versions."},
        "compiler_settings": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "optimizer": {"type": "boolean"},
            "yul_optimizer": {"type": "boolean"},
            "via_ir": {"type": "boolean"},
            "abi_encoder_v2": {"type": "boolean"},
            "evm_version": {"type": "string"}
          }
        },
        "dependencies": {
          "type": "array",
          "minItems": 1,
          "description": "Applies if ANY listed package is installed in a matching version.",
          "items": {
            "type": "object",
            "required": ["package", "range"],
            "additionalProperties": false,
            "properties": {
              "package": {"type": "string", "minLength": 1},
              "range": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "detectionHint": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "slither": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "ast_pattern": {"type": "string", "minLength": 1}
      }
    },
    "verification": {
      "type": "object",
      "required": ["method"],
      "additionalProperties": false,
      "properties": {
        "method": {"enum": ["invariant_fuzz", "poc_test", "manual_only"]},
        "property": {"type": "string", "minLength": 1}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["sources", "last_reviewed"],
      "additionalProperties": false,
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["type", "url"],
            "additionalProperties": false,
            "properties": {
              "type": {"enum": ["cyfrin", "ghsa", "solidity_blog", "solidity_bugs_json", "audit_report", "other"]},
              "ref": {"type": "string", "minLength": 1},
              "url": {"type": "string", "minLength": 1}
            }
          }
        },
        "last_reviewed": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
      }
    }
  }
}
